# For deploying the printcast stack BY HAND. From Komodo, put the same lines in
# the Stack's Environment instead (see "Deploying from Komodo" in the README).
#
# For the printcast stack (compose.yml in this directory). Copy to stack.env
# (gitignored), fill in, and load into the shell before deploying -- stack
# deploy reads the environment, not this file:
#
#   set -a; . apps/printcast/stack.env; set +a
#   docker stack deploy -c apps/printcast/compose.yml printcast
#
# Sourced by the shell, so anything with a $ in it goes in single quotes.

# The printer. Its touchscreen's network settings show the IP and the access
# code; the serial number is on its device info screen and in Bambu Handy /
# Bambu Studio under the printer's details. Give the printer a DHCP
# reservation, or this address goes stale.
BAMBU_HOST=
BAMBU_ACCESS_CODE=
BAMBU_SERIAL=
# BAMBU_NAME=X2D
# BAMBU_VERBOSE=true      # MQTT/camera detail in the service logs

# Basic auth for https://print.liaxum.fr, as a bcrypt htpasswd line:
#   docker run --rm httpd:alpine htpasswd -nbB admin 'your-password'
PRINTCAST_AUTH=''

# DOMAIN=liaxum.fr
# PRINT_SUBDOMAIN=print
# OBS_SUBDOMAIN=obs
# MINI_HOSTNAME=liaxum-mini
# GAMING_HOSTNAME=liaxum-gaming
