# Copy to .env next to compose.yml (gitignored) or set these in the Komodo
# Stack's environment. The first five are required; compose refuses to start
# without them.

# liaxum-mini's Tailscale address -- `tailscale ip -4` on the mini PC. Every
# UI in this stack binds to it and nothing else.
MINI_MESH_ADDR=

# The printer. Its touchscreen's network settings show the IP and the access
# code; the serial number is on its device info screen and in Bambu Handy /
# Bambu Studio under the printer's details. Give the printer a DHCP
# reservation, or this address goes stale.
BAMBU_HOST=
BAMBU_ACCESS_CODE=
BAMBU_SERIAL=
# BAMBU_NAME=X2D

# Basic auth on the OBS desktop.
OBS_PASSWORD=
# OBS_USER=admin

# TZ=Europe/Paris
# BAMBUBOARD_PORT=8080
# OBS_PORT=3001
# OBS_HTTP_PORT=3000     # what web.yml's relay forwards to
