# Copy to .env next to this compose.yml (gitignored) when deploying by hand.
# From Komodo, put the same lines in the Stack's Environment instead.

# The OBS desktop's login. It is the only one in front of the desktop on the
# web, so make it long.
OBS_PASSWORD=
# OBS_USER=admin

# TZ=Europe/Paris

# obs-websocket's password, used by the autostream service. Defaults to
# OBS_PASSWORD.
# OBS_WS_PASSWORD=

# Go live while a print is active ("printing") or whenever the printer is
# reporting ("online"), and keep streaming STOP_DELAY seconds after it ends.
# STREAM_WHEN=printing
# STOP_DELAY=300
