# Copy to .env next to this compose.yml (gitignored) when deploying by hand.
# From Komodo, put the same lines in the Stack's Environment instead.

# The OBS desktop's login. It is the only one in front of the desktop on the
# web, so make it long.
OBS_PASSWORD=
# OBS_USER=admin

# TZ=Europe/Paris

# obs-websocket's password, used by the autostream service. Defaults to
# OBS_PASSWORD.
# OBS_WS_PASSWORD=

# Live while the printer is switched on ("online") or while a print is
# active ("printing"); off air STOP_DELAY seconds after that ends. With
# MANAGE_OBS the OBS container itself is started and stopped along with it.
# STREAM_WHEN=online
# STOP_DELAY=300
# MANAGE_OBS=true
